---
import Image from "astro/components/Image.astro";
import MainLayout from "../Layouts/MainLayout.astro";
import institucional from "../../public/3.jpg";
import ImageSlider from "../components/ImageSlider.astro";
import {
	imagenesBienestar,
	imagenesReconocimientos,
} from "../common/variables.astro";
---

<style>
	.reveal {
		opacity: 0;
		transform: translateY(40px);
		transition: all 0.8s ease-out;
	}
	.reveal.active {
		opacity: 1;
		transform: translateY(0);
	}
</style>
<MainLayout
	title="Quiénes Somos | Empresa de seguridad privada con operación nacional | ASEINTEG LTDA"
	description="Conozca la historia, misión, visión y valores de ASEINTEG LTDA, una empresa colombiana con más de 25 años de experiencia en seguridad privada."
	canonical="/nosotros"
	showFooter={false}
>
	<!-- ======================================================
     HERO – QUIÉNES SOMOS
======================================================= -->
	<section class="bg-[var(--color-background-dark)] text-white">
		<div class="max-w-7xl mx-auto px-6 py-24 reveal">
			<h1 class="text-4xl font-bold">Quiénes Somos</h1>
		</div>
	</section>

	<!-- ======================================================
     NUESTRA ESENCIA
======================================================= -->
	<section>
		<div
			class="max-w-7xl mx-auto px-6 py-20 grid gap-12 lg:grid-cols-2 items-center"
		>
			<div class="reveal">
				<h2 class="text-3xl font-bold text-[var(--color-primary)]">
					Seguridad privada con respaldo real
				</h2>
				<p class="mt-6 text-slate-600">
					Brindamos servicios de vigilancia y seguridad privada a nivel
					nacional, estructurados para adaptarse a las necesidades
					residenciales, comerciales, industriales e institucionales.
				</p>
				<p class="mt-4 text-slate-600">
					Nuestros esquemas de seguridad se estructuran para entornos
					residenciales, comerciales, industriales e institucionales, combinando
					talento humano certificado, supervisión operativa y tecnología
					conforme a la normativa vigente.
				</p>
			</div>

			<div
				class="reveal rounded-2xl bg-white border border-slate-200 h-72 flex items-center justify-center"
			>
				<Image
					src={institucional}
					class="h-full w-full object-cover"
					alt="Imagen institucional"
				/>
			</div>
		</div>
	</section>

	<!-- ======================================================
     HISTORIA Y TRAYECTORIA
======================================================= -->
	<section class="bg-white">
		<div
			class="max-w-7xl mx-auto px-6 py-20 grid grid-cols-1 lg:grid-cols-2 gap-16 items-center reveal"
		>
			<!-- Content -->
			<div>
				<h2 class="text-3xl font-bold text-[var(--color-primary)]">
					Nuestros comienzos
				</h2>

				<p class="mt-6 max-w-xl text-slate-600 leading-relaxed">
					<strong>ASEINTEG LTDA</strong> inició operaciones en Girardot. Gracias a
					metodologías claras y experiencia acumulada, ha expandido su alcance a lo
					largo del territorio colombiano, atendiendo distintas regiones con la misma
					consistencia operativa.
				</p>
			</div>

			<!-- Image -->
			<div class="relative">
				<img
					src="/quienessomos/historia.jpg"
					alt="Historia"
					class="w-full h-full max-h-[420px] object-cover rounded-3xl shadow-lg"
					loading="lazy"
				/><figcaption class="mt-2 text-center text-sm text-gray-600 italic">
					Retrato de época
				</figcaption>
			</div>
		</div>
	</section>

	<!-- ======================================================
     MISIÓN Y VISIÓN
======================================================= -->
	<section>
		<div class="max-w-7xl mx-auto px-6 py-20 grid gap-12 md:grid-cols-2">
			<div class="reveal rounded-2xl bg-white border border-slate-200 p-8">
				<h3 class="text-xl font-semibold text-[var(--color-primary)]">
					Nuestra misión
				</h3>
				<p class="mt-4 text-slate-600">
					Suministrar a nivel nacional los servicios de vigilancia privada
					integral en la modalidad de vigilancia fija con el propósito de velar
					por la integridad personal y seguridad de los bienes de las personas o
					entidades que reciben nuestra protección.
				</p>
			</div>

			<div class="reveal rounded-2xl bg-white border border-slate-200 p-8">
				<h3 class="text-xl font-semibold text-[var(--color-primary)]">
					Nuestra visión
				</h3>
				<p class="mt-4 text-slate-600">
					Ser una empresa altamente competitiva en el sector de la vigilancia y
					seguridad privada, con altos niveles de calidad en nuestros procesos,
					para continuar neutralizando eficazmente los intentos delincuenciales,
					protegiendo a nuestros clientes y sus intereses.
				</p>
			</div>
		</div>
	</section>

	<!-- ======================================================
     TALENTO HUMANO
======================================================= -->
	<section class="bg-white">
		<div
			class="max-w-7xl mx-auto px-6 py-20 grid grid-cols-1 lg:grid-cols-2 gap-16 items-center reveal"
		>
			<!-- Content -->
			<div>
				<h2 class="text-3xl font-bold text-[var(--color-primary)]">
					Nuestro talento humano
				</h2>

				<p class="mt-6 max-w-xl text-slate-600 leading-relaxed">
					Nuestro equipo combina experiencia, entrenamiento riguroso y
					desarrollo continuo para ofrecer un servicio con altos estándares
					operativos.
				</p>

				<ul class="mt-6 space-y-3 text-slate-600">
					<li>✔ Procesos rigurosos de selección</li>
					<li>✔ Evaluaciones médicas y psicológicas</li>
					<li>✔ Capacitación continua</li>
					<li>✔ Contratos legales y bienestar laboral</li>
				</ul>
			</div>

			<!-- Image -->
			<div class="relative">
				<img
					src="/quienessomos/talento.jpg"
					alt="Talento"
					class="w-full h-full max-h-[420px] object-cover object-[80%_70%] rounded-3xl shadow-lg"
					loading="lazy"
				/>
			</div>
		</div>
	</section>
	<!-- ======================================================
     VALORES
======================================================= -->
	<section class="">
		<div
			class="max-w-7xl mx-auto px-6 py-20 grid grid-cols-1 lg:grid-cols-2 gap-16 items-center reveal"
		>
			<!-- Content -->
			<div>
				<h2 class="text-3xl font-bold text-[var(--color-primary)]">
					Nuestros valores
				</h2>

				<ul class="mt-6 space-y-3 text-slate-600">
					<li>✔ Compromiso con el cumplimiento legal</li>
					<li>✔ Responsabilidad operativa</li>
					<li>✔ Ética profesional</li>
					<li>✔ Mejora continua</li>
					<li>✔ Trabajo en equipo</li>
				</ul>
			</div>

			<!-- Image -->
			<div class="relative">
				<img
					src="/quienessomos/valores.jpg"
					alt="Valores"
					class="w-full h-full max-h-[420px] object-cover object-center rounded-3xl shadow-lg"
					loading="lazy"
				/>
			</div>
		</div>
	</section>
	<!-- ======================================================
     BIENESTAR
======================================================= -->
	<section class="bg-white">
		<div
			class="max-w-7xl mx-auto px-6 py-20 grid grid-cols-1 lg:grid-cols-2 gap-16 items-center reveal"
		>
			<!-- Content -->
			<div>
				<h2 class="text-3xl font-bold text-[var(--color-primary)]">
					Bienestar a nuestros colaboradores
				</h2>

				<p class="mt-6 max-w-xl text-slate-600 leading-relaxed">
					Creemos que una seguridad sólida empieza por el bienestar de quienes
					la hacen posible. Por eso promovemos espacios de integración, cercanía
					y reconocimiento para nuestros colaboradores y sus familias.
				</p>
				<p class="mt-6 max-w-xl text-slate-600 leading-relaxed">
					Lo hacemos a traves de:
				</p>
				<ul class="mt-6 space-y-3 text-slate-600">
					<li>
						⚽ Actividades deportivas y recreativas que fortalecen el trabajo en
						equipo
					</li>
					<li>🎉 Encuentros familiares y celebraciones institucionales</li>
					<li>
						🤝 Espacios de integración que refuerzan el sentido de pertenencia
					</li>
				</ul>
			</div>

			<!-- Image -->
			<!-- Image -->
			<div class="relative">
				<ImageSlider
					imagenes={imagenesBienestar}
					classes="w-full h-full max-h-[420px] object-cover object-center rounded-3xl shadow-lg"
					duration="1500"
				/>
			</div>
		</div>
	</section>
	<!-- ======================================================
     RECONOCMIENTOS
======================================================= -->
	<section class="bg-white/50">
		<div
			class="max-w-7xl mx-auto px-6 py-20 grid grid-cols-1 lg:grid-cols-2 gap-16 items-center reveal"
		>
			<!-- Content -->
			<div>
				<h2 class="text-3xl font-bold text-[var(--color-primary)]">
					Reconocimientos
				</h2>

				<p class="mt-6 max-w-xl text-slate-600 leading-relaxed">
					Nuestro trabajo ha sido respaldado por reconocimientos y
					certificaciones que reflejan el compromiso permanente con la calidad,
					el cumplimiento normativo y la mejora continua.
				</p>
				<p class="mt-6 max-w-xl text-slate-600 leading-relaxed">
					Lo hacemos a traves de:
				</p>
				<ul class="mt-6 space-y-3 text-slate-600">
					<li>🏆 Reconocimientos institucionales</li>
					<li>📄 Certificaciones y estándares de calidad</li>
					<li>🤝 Confianza construida con nuestros clientes</li>
				</ul>
			</div>

			<!-- Image -->
			<div class="relative">
				<ImageSlider
					imagenes={imagenesReconocimientos}
					classes="w-full h-full max-h-[420px] object-contain object-center rounded-3xl shadow-lg"
					duration="2000"
				/>
			</div>
		</div>
	</section>

	<!-- ======================================================
     LICENCIA DE FUNCIOANMIENTO
======================================================= -->
	<section class="bg-white md:grid md:grid-cols-2">
		<div class="max-w-7xl pl-10 mx-auto py-10 reveal">
			<h2 class="text-3xl font-bold text-[var(--color-primary)]">
				Licencia No 20194100102537 Supervigilancia
			</h2>

			<ul class="mt-6 space-y-3 text-slate-600">
				<li>✔ Medios tecnológicos</li>
				<li>✔ Cerca eléctrica</li>
				<li>✔ Circuito cerrado de televisión</li>
				<li>✔ Escolta de personas, vehículos y mercancias</li>
			</ul>
		</div>

		<div class="max-w-7xl pl-10 mx-auto py-10 reveal">
			<h2 class="text-3xl font-bold text-[var(--color-primary)]">Polizas</h2>

			<ul class="mt-6 space-y-3 text-slate-600">
				<li>✔ Responsabilidad civil contractual</li>
				<li>✔ Hurto</li>
				<li>✔ Seguro de vida</li>
			</ul>
		</div>
	</section>
	<!-- ======================================================
     LICENCIA DE FUNCIOANMIENTO
======================================================= -->
	<section class="bg-white">
		
	</section>

	<!-- ======================================================
     CTA FINAL
======================================================= -->
	<section class="bg-[var(--color-primary)] text-white">
		<div class="max-w-7xl mx-auto px-6 py-16 text-center reveal">
			<h2 class="text-3xl font-bold">
				Conozca cómo podemos proteger su operación
			</h2>
			<p class="mt-4 text-emerald-100">
				Diagnóstico profesional sin costo ni compromiso.
			</p>
			<a
				href="/contacto"
				class="inline-block mt-8 rounded-xl bg-[var(--color-accent)] px-8 py-3 font-semibold text-[var(--color-background-dark)] hover:opacity-90 transition"
			>
				Solicite su estudio de seguridad gratuito
			</a>
		</div>
	</section>

	<!-- ======================================================
     SCRIPT – ANIMACIÓN ON-SCROLL
======================================================= -->
	<script>
		const reveals = document.querySelectorAll(".reveal");

		const observer = new IntersectionObserver(
			(entries) => {
				entries.forEach((entry) => {
					if (entry.isIntersecting) {
						entry.target.classList.add("active");
						observer.unobserve(entry.target);
					}
				});
			},
			{ threshold: 0.15 },
		);

		reveals.forEach((el) => observer.observe(el));
	</script>
</MainLayout>
